# ----------------------------------------------------------------------
# CONFIG + CLASSES (noyau stable)
# ----------------------------------------------------------------------
CONFIG = {"min_sources_high_stakes": 2}


@dataclass
class DecisionContext:
    speech_act: str
    goal: str
    domain: str
    truth_apt: bool
    verification: str
    external_sources: str
    sensitivity: str
    stakes_level: str
    stakes_reason: List[str] = field(default_factory=list)
    contains_hypothesis: bool = False
    contains_causal_claim: bool = False
    contains_quantitative_claim: bool = False
    analysis_confidence: float = 0.75
    intent_tags: List[str] = field(default_factory=list)
    uncertainty_level: float = 0.5
    reasoning_depth: str = "medium"


class ConstraintClass(Enum):
    SECURITE = 3
    EPISTEMIQUE = 2
    OPTIMISATION = 1


@dataclass
class Constraint:
    name: str
    cls: ConstraintClass
    detail: str


# ----------------------------------------------------------------------
# Kernel + Orchestrateur
# ----------------------------------------------------------------------
def kernel_decide(ctx: DecisionContext) -> List[Constraint]:
    constraints = []
    if ctx.truth_apt and ctx.verification == "required":
        constraints.append(Constraint("verification_obligatoire", ConstraintClass.SECURITE, "Vérification obligatoire"))
    if ctx.external_sources == "required" or ctx.stakes_level == "high":
        constraints.append(Constraint("sources_min", ConstraintClass.EPISTEMIQUE, f"≥{CONFIG['min_sources_high_stakes']} sources"))
    if ctx.stakes_level == "high" or ctx.contains_causal_claim or ctx.contains_quantitative_claim:
        constraints.append(Constraint("mode_d_obligatoire", ConstraintClass.EPISTEMIQUE, "Mode D activé"))
    constraints.extend([
        Constraint("consensus_non_preuve", ConstraintClass.EPISTEMIQUE, "Consensus ≠ preuve"),
        Constraint("tracabilite", ConstraintClass.EPISTEMIQUE, "Traçabilité obligatoire"),
    ])
    if ctx.contains_hypothesis and ctx.truth_apt:
        constraints.append(Constraint("checklist_hypothese", ConstraintClass.EPISTEMIQUE, "Checklist VERITAS"))
    return constraints


def resolve_conflicts(constraints: List[Constraint]) -> List[Constraint]:
    names = {c.name for c in constraints}
    if "verification_obligatoire" in names:
        constraints = [c for c in constraints if c.cls != ConstraintClass.OPTIMISATION]
    return sorted(constraints, key=lambda c: c.cls.value, reverse=True)


def build_pipeline(ctx: DecisionContext, constraints: List[Constraint]) -> dict:
    names = {c.name for c in constraints}
    return {
        "context_summary": {
            "stakes": ctx.stakes_level,
            "mode_d": "mode_d_obligatoire" in names,
            "confidence": ctx.analysis_confidence,
            "uncertainty": ctx.uncertainty_level,
        },
        "n_models": 3 if "mode_d_obligatoire" in names else (2 if "sources_min" in names else 1),
        "web_search_required": any(x in names for x in ["verification_obligatoire", "sources_min", "mode_d_obligatoire"]),
        "min_independent_sources": CONFIG["min_sources_high_stakes"] if any(x in names for x in ["sources_min", "mode_d_obligatoire"]) else 0,
        "mode_d": "mode_d_obligatoire" in names,
        "constraints_applied": [f"[{c.cls.name}] {c.name}" for c in constraints],
    }


# ----------------------------------------------------------------------
# LLM CALLER — OpenAI Compatible (xAI / OpenAI / compatibles)
# ----------------------------------------------------------------------
def openai_compatible_caller(prompt: str, model: str = "grok-3") -> str:
    """Fonction compatible OpenAI (fonctionne avec xAI, OpenAI, Groq, etc.)"""
    api_key = os.getenv("XAI_API_KEY") or os.getenv("OPENAI_API_KEY")
    base_url = os.getenv("API_BASE_URL", "https://api.x.ai/v1")

    if not api_key:
        raise ValueError("Définis XAI_API_KEY ou OPENAI_API_KEY dans l'environnement")

    system_prompt = """Analyse le prompt utilisateur et retourne UNIQUEMENT un JSON valide avec exactement ces champs :
{
  "speech_act": "...", "goal": "...", "domain": "...",
  "truth_apt": true/false, "verification": "none|optional|required",
  "external_sources": "none|recommended|required",
  "sensitivity": "low|medium|high", "stakes_level": "low|medium|high",
  "stakes_reason": ["..."], "contains_hypothesis": true/false,
  "contains_causal_claim": true/false, "contains_quantitative_claim": true/false,
  "analysis_confidence": 0.XX, "intent_tags": ["tag1"],
  "uncertainty_level": 0.XX, "reasoning_depth": "shallow|medium|deep"
}
Ne retourne rien d'autre que ce JSON (pas de texte, pas de balises markdown)."""

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"Prompt à analyser : {prompt}"},
        ],
        "temperature": 0.1,
        "max_tokens": 700,
    }

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }

    try:
        response = requests.post(
            f"{base_url}/chat/completions",
            json=payload,
            headers=headers,
            timeout=20,
        )
        response.raise_for_status()
    except requests.RequestException as e:
        raise RuntimeError(f"Erreur d'appel API : {e}") from e

    try:
        content = response.json()["choices"][0]["message"]["content"]
    except (KeyError, IndexError, ValueError) as e:
        raise RuntimeError(f"Réponse API mal formée : {e}") from e

    # Extraction robuste du JSON (au cas où le modèle ajoute du texte autour)
    start = content.find('{')
    end = content.rfind('}') + 1
    if start >= 0 and end > start:
        return content[start:end]
    return content


# ----------------------------------------------------------------------
# Analyzer + Run
# ----------------------------------------------------------------------
class PromptAnalyzerLLM:
    def analyze(self, prompt: str) -> DecisionContext:
        try:
            raw = openai_compatible_caller(prompt)
            data = json.loads(raw)
        except Exception as e:
            print(f"[avertissement] analyse LLM indisponible ou invalide ({e}), valeurs par défaut utilisées.")
            data = {}

        return DecisionContext(
            speech_act=data.get("speech_act", "other"),
            goal=data.get("goal", "other"),
            domain=data.get("domain", "conversation"),
            truth_apt=data.get("truth_apt", False),
            verification=data.get("verification", "optional"),
            external_sources=data.get("external_sources", "none"),
            sensitivity=data.get("sensitivity", "medium"),
            stakes_level=data.get("stakes_level", "low"),
            stakes_reason=data.get("stakes_reason", []),
            contains_hypothesis=data.get("contains_hypothesis", False),
            contains_causal_claim=data.get("contains_causal_claim", False),
            contains_quantitative_claim=data.get("contains_quantitative_claim", False),
            analysis_confidence=data.get("analysis_confidence", 0.75),
            intent_tags=data.get("intent_tags", []),
            uncertainty_level=data.get("uncertainty_level", 0.5),
            reasoning_depth=data.get("reasoning_depth", "medium"),
        )


def run(prompt: str) -> dict:
    ctx = PromptAnalyzerLLM().analyze(prompt)
    constraints = resolve_conflicts(kernel_decide(ctx))
    return build_pipeline(ctx, constraints)


