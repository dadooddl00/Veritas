pythonimport os
import json
import re
from enum import Enum
from dataclasses import dataclass, field
from typing import List
import requests

# ----------------------------------------------------------------------
# CONFIG + CLASSES (noyau stable)
# ----------------------------------------------------------------------
CONFIG = {"min_sources_high_stakes": 2}


@dataclass
class DecisionContext:
    speech_act: str
    goal: str
    domain: str
    truth_apt: bool
    verification: str
    external_sources: str
    sensitivity: str
    stakes_level: str          # "low" | "medium" | "high"
    stakes_reason: List[str] = field(default_factory=list)
    contains_hypothesis: bool = False
    contains_causal_claim: bool = False
    contains_quantitative_claim: bool = False
    analysis_confidence: float = 0.75
    intent_tags: List[str] = field(default_factory=list)
    uncertainty_level: float = 0.5
    reasoning_depth: str = "medium"
    is_controversial: bool = False
    explicit_depth_request: bool = False
    is_sensitive_risk: bool = False   # Fix #1 : santé/sécurité/danger


class ConstraintClass(Enum):
    SECURITE = 3
    EPISTEMIQUE = 2
    OPTIMISATION = 1


@dataclass
class Constraint:
    name: str
    cls: ConstraintClass
    detail: str


# ----------------------------------------------------------------------
# TRIAGE : Direct / Standard / Approfondi
# ----------------------------------------------------------------------
def determine_mode(ctx: DecisionContext) -> str:
    # Fix #1 : un sujet à risque (santé/sécurité) force le mode Approfondi
    # même sans mot-clé "controverse" ou "approfondi" explicite.
    if (
        ctx.is_controversial
        or ctx.is_sensitive_risk
        or ctx.explicit_depth_request
        or ctx.uncertainty_level >= 0.7
        or (ctx.stakes_level == "high" and (ctx.contains_causal_claim or ctx.contains_quantitative_claim))
    ):
        return "approfondi"

    if (
        ctx.stakes_level == "low"
        and not ctx.contains_hypothesis
        and not ctx.contains_causal_claim
        and not ctx.contains_quantitative_claim
        and ctx.verification != "required"
        and ctx.uncertainty_level < 0.4
    ):
        return "direct"

    return "standard"


def kernel_decide(ctx: DecisionContext) -> List[Constraint]:
    constraints = []
    mode = determine_mode(ctx)

    # Fix #1 : risque santé/sécurité => vérification obligatoire, quel que
    # soit le mode d'expression — pas seulement basé sur ctx.verification
    # qui peut être mal classifié en amont.
    if (ctx.truth_apt and ctx.verification == "required") or ctx.is_sensitive_risk:
        constraints.append(Constraint("verification_obligatoire", ConstraintClass.SECURITE,
                                       "Vérification obligatoire (fait sensible ou requis explicitement)"))

    if mode == "standard":
        constraints.append(Constraint("mode_standard", ConstraintClass.EPISTEMIQUE,
                                       "Séparer su/interprété/inconnu ; envisager 1 alternative ; vérifier si besoin ; confiance explicite"))
        if ctx.external_sources in ("recommended", "required") or ctx.contains_quantitative_claim:
            constraints.append(Constraint("sources_min", ConstraintClass.EPISTEMIQUE,
                                           "≥1 source pour affirmation datée/chiffrée"))

    if mode == "approfondi":
        constraints.append(Constraint("mode_d_obligatoire", ConstraintClass.EPISTEMIQUE,
                                       "≥2 modèles explicatifs concurrents, test discriminant, conclusion provisoire"))
        constraints.append(Constraint("sources_min", ConstraintClass.EPISTEMIQUE,
                                       f"≥{CONFIG['min_sources_high_stakes']} sources indépendantes"))

    # Fix #3 : "consensus ≠ preuve" n'a de sens que s'il y a effectivement
    # plusieurs modèles consultés (mode != "direct"). Sinon décorative.
    if mode != "direct":
        constraints.append(Constraint("consensus_non_preuve", ConstraintClass.EPISTEMIQUE,
                                       "Convergence inter-modèles ≠ preuve : exige ≥1 source externe indépendante"))
    constraints.append(Constraint("tracabilite", ConstraintClass.EPISTEMIQUE, "Traçabilité obligatoire"))

    # Fix #4 (Art. 9 / Étape 5) : la checklist hypothèse s'applique au moment
    # d'un test discriminant, donc seulement en mode "approfondi".
    if ctx.contains_hypothesis and ctx.truth_apt and mode == "approfondi":
        constraints.append(Constraint("checklist_hypothese", ConstraintClass.EPISTEMIQUE,
                                       "Art. 9 : checklist 6 étapes (Annexe) avant verdict sur l'hypothèse"))

    if mode == "direct":
        constraints.append(Constraint("cout_minimal", ConstraintClass.OPTIMISATION,
                                       "Tâche mécanique/faible enjeu : 1 seul modèle, pas de recherche"))

    return constraints


def resolve_conflicts(constraints: List[Constraint]) -> List[Constraint]:
    names = {c.name for c in constraints}
    if "verification_obligatoire" in names:
        constraints = [c for c in constraints if c.cls != ConstraintClass.OPTIMISATION]
    return sorted(constraints, key=lambda c: c.cls.value, reverse=True)


def build_pipeline(ctx: DecisionContext, constraints: List[Constraint]) -> dict:
    names = {c.name for c in constraints}
    mode = determine_mode(ctx)

    if mode == "approfondi":
        n_models = 3
    elif mode == "standard":
        n_models = 2
    else:
        n_models = 1

    min_sources = CONFIG["min_sources_high_stakes"] if "mode_d_obligatoire" in names else (1 if "sources_min" in names else 0)
    if "consensus_non_preuve" in names and min_sources == 0:
        min_sources = 1

    return {
        "mode": mode,
        "context_summary": {
            "stakes": ctx.stakes_level,
            "confidence": ctx.analysis_confidence,
            "uncertainty": ctx.uncertainty_level,
            "risk": ctx.is_sensitive_risk,
        },
        "n_models": n_models,
        "web_search_required": any(x in names for x in ["verification_obligatoire", "sources_min", "mode_d_obligatoire", "consensus_non_preuve"]),
        "min_independent_sources": min_sources,
        "checklist_hypothese_annexe": "checklist_hypothese" in names,
        "constraints_applied": [f"[{c.cls.name}] {c.name}" for c in constraints],
    }


# ----------------------------------------------------------------------
# LLM CALLER — OpenAI Compatible (xAI / OpenAI / compatibles)
# ----------------------------------------------------------------------
def openai_compatible_caller(prompt: str, model: str = "grok-3") -> str:
    api_key = os.getenv("XAI_API_KEY") or os.getenv("OPENAI_API_KEY")
    base_url = os.getenv("API_BASE_URL", "https://api.x.ai/v1")

    if not api_key:
        raise ValueError("Définis XAI_API_KEY ou OPENAI_API_KEY dans l'environnement")

    system_prompt = """Analyse le prompt utilisateur et retourne UNIQUEMENT un JSON valide avec exactement ces champs :
{
  "speech_act": "...", "goal": "...", "domain": "...",
  "truth_apt": true/false, "verification": "none|optional|required",
  "external_sources": "none|recommended|required",
  "sensitivity": "low|medium|high", "stakes_level": "low|medium|high",
  "stakes_reason": ["..."], "contains_hypothesis": true/false,
  "contains_causal_claim": true/false, "contains_quantitative_claim": true/false,
  "analysis_confidence": 0.XX, "intent_tags": ["tag1"],
  "uncertainty_level": 0.XX, "reasoning_depth": "shallow|medium|deep",
  "is_controversial": true/false, "explicit_depth_request": true/false,
  "is_sensitive_risk": true/false
}
Ne retourne rien d'autre que ce JSON (pas de texte, pas de balises markdown)."""

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"Prompt à analyser : {prompt}"},
        ],
        "temperature": 0.1,
        "max_tokens": 700,
    }
    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}

    try:
        response = requests.post(f"{base_url}/chat/completions", json=payload, headers=headers, timeout=20)
        response.raise_for_status()
    except requests.RequestException as e:
        raise RuntimeError(f"Erreur d'appel API : {e}") from e

    try:
        content = response.json()["choices"][0]["message"]["content"]
    except (KeyError, IndexError, ValueError) as e:
        raise RuntimeError(f"Réponse API mal formée : {e}") from e

    start = content.find('{')
    end = content.rfind('}') + 1
    if start < 0 or end <= start:
        raise RuntimeError("Aucun objet JSON trouvé dans la réponse du LLM")
    return content[start:end]


# ----------------------------------------------------------------------
# VALIDATION DE SCHÉMA (Fix #8, durci)
# ----------------------------------------------------------------------
_VALID_LEVELS = {"low", "medium", "high"}
_VALID_TRISTATE = {"none", "optional", "recommended", "required"}
_VALID_DEPTH = {"shallow", "medium", "deep"}

# Tous les champs attendus sont désormais requis explicitement — plus
# d'omission silencieuse des 4 champs qui manquaient (stakes_reason,
# analysis_confidence, intent_tags, reasoning_depth).
_REQUIRED_FIELDS = {
    "speech_act", "goal", "domain", "truth_apt", "verification",
    "external_sources", "sensitivity", "stakes_level", "stakes_reason",
    "contains_hypothesis", "contains_causal_claim", "contains_quantitative_claim",
    "analysis_confidence", "intent_tags", "uncertainty_level", "reasoning_depth",
    "is_controversial", "explicit_depth_request", "is_sensitive_risk",
}

# Champs qui DOIVENT être un booléen Python réel (pas une chaîne "true"/"false",
# pas 0/1). C'est précisément le trou qui permettait à "contains_hypothesis":
# "false" (chaîne) d'être évalué comme vrai par Python — corrigé ici.
_BOOL_FIELDS = {
    "truth_apt", "contains_hypothesis", "contains_causal_claim",
    "contains_quantitative_claim", "is_controversial",
    "explicit_depth_request", "is_sensitive_risk",
}

_LIST_STR_FIELDS = {"stakes_reason", "intent_tags"}


def validate_schema(data: dict) -> None:
    """Fix #8 : rejette explicitement un JSON incomplet, mal typé ou hors
    énumération, au lieu de laisser DecisionContext absorber silencieusement
    des valeurs invalides via des .get() avec défaut."""
    if not isinstance(data, dict):
        raise ValueError(f"schéma attendu: objet JSON, reçu: {type(data).__name__}")

    missing = _REQUIRED_FIELDS - data.keys()
    if missing:
        raise ValueError(f"Champs manquants dans la réponse LLM : {missing}")

    for key in _BOOL_FIELDS:
        if not isinstance(data[key], bool):
            raise ValueError(f"'{key}' doit être un booléen JSON réel, reçu: {data[key]!r} ({type(data[key]).__name__})")

    for key in _LIST_STR_FIELDS:
        v = data[key]
        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
            raise ValueError(f"'{key}' doit être une liste de chaînes, reçu: {v!r}")

    if data["stakes_level"] not in _VALID_LEVELS:
        raise ValueError(f"stakes_level invalide : {data['stakes_level']!r}")
    if data["sensitivity"] not in _VALID_LEVELS:
        raise ValueError(f"sensitivity invalide : {data['sensitivity']!r}")
    if data["verification"] not in _VALID_TRISTATE:
        raise ValueError(f"verification invalide : {data['verification']!r}")
    if data["external_sources"] not in _VALID_TRISTATE:
        raise ValueError(f"external_sources invalide : {data['external_sources']!r}")
    if data["reasoning_depth"] not in _VALID_DEPTH:
        raise ValueError(f"reasoning_depth invalide : {data['reasoning_depth']!r}")

    for key in ("uncertainty_level", "analysis_confidence"):
        v = data[key]
        if not isinstance(v, (int, float)) or isinstance(v, bool):
            raise ValueError(f"'{key}' doit être un nombre, reçu: {type(v).__name__}")
        if not (0.0 <= float(v) <= 1.0):
            raise ValueError(f"'{key}' hors bornes [0.0, 1.0] : {v!r}")

    for key in ("speech_act", "goal", "domain"):
        if not isinstance(data[key], str) or not data[key].strip():
            raise ValueError(f"'{key}' doit être une chaîne non vide, reçu: {data[key]!r}")


# ----------------------------------------------------------------------
# ANALYSEUR LOCAL SANS API (mode test / offline)
# ----------------------------------------------------------------------
def local_heuristic_analyzer(prompt: str) -> dict:
    p = prompt.lower()

    # Fix #9 : exiger un chiffre à ≥2 chiffres consécutifs OU un mot-clé
    # explicite, pour éviter qu'un simple "5" ("top 5") déclenche sources_min.
    quantitative = bool(re.search(r"\d{2,}", p)) or any(
        w in p for w in ["combien", "pourcentage", "taux", "chiffre", "statistique"]
    )
    causal = any(w in p for w in ["pourquoi", "cause", "entraîne", "provoque", "à cause de", "en raison de"])
    hypothesis = any(w in p for w in ["si ", "suppose", "hypothèse", "imaginons", "et si"])
    controversial = any(w in p for w in ["controvers", "débat", "polémique", "conspiration", "complot",
                                          "convergence", "épistémolog", "epistemolog", "veritas"])
    explicit_depth = any(w in p for w in ["en profondeur", "approfondi", "détaillé", "analyse complète",
                                           "compare en détail", "explore"])
    dated_or_current = any(w in p for w in ["actuel", "aujourd'hui", "récent", "cette année", "maintenant",
                                             "qui est", "ceo", "président", "dernière version"])
    sensitive_risk = any(w in p for w in [
        "vaccin", "santé", "sécurité", "danger", "médicament", "dose",
        "arme", "explosif", "toxique", "overdose", "suicide"
    ])

    if controversial or explicit_depth or sensitive_risk:
        stakes = "high"
    elif causal or quantitative or dated_or_current:
        stakes = "medium"
    else:
        stakes = "low"

    verification = "required" if (dated_or_current or quantitative or sensitive_risk) else "optional"
    external_sources = "required" if (dated_or_current or controversial or sensitive_risk) else ("recommended" if quantitative else "none")
    uncertainty = 0.8 if controversial else (0.5 if (causal or hypothesis) else 0.2)

    return {
        "speech_act": "question",
        "goal": "information",
        "domain": "general",
        "truth_apt": True,
        "verification": verification,
        "external_sources": external_sources,
        "sensitivity": "high" if sensitive_risk else ("medium" if controversial else "low"),
        "stakes_level": stakes,
        "stakes_reason": ["heuristique_locale"],
        "contains_hypothesis": hypothesis,
        "contains_causal_claim": causal,
        "contains_quantitative_claim": quantitative,
        "analysis_confidence": 0.5,
        "intent_tags": [],
        "uncertainty_level": uncertainty,
        "reasoning_depth": "shallow",
        "is_controversial": controversial,
        "explicit_depth_request": explicit_depth,
        "is_sensitive_risk": sensitive_risk,
    }


# ----------------------------------------------------------------------
# Analyzer + Run
# ----------------------------------------------------------------------
class PromptAnalyzerLLM:
    def __init__(self, offline: bool = False):
        self.offline = offline

    def analyze(self, prompt: str) -> DecisionContext:
        if self.offline:
            data = local_heuristic_analyzer(prompt)
            # Validée aussi côté offline : même garantie partout, détecte
            # immédiatement une régression si la fonction est modifiée.
            validate_schema(data)
        else:
            try:
                raw = openai_compatible_caller(prompt)
                data = json.loads(raw)
                validate_schema(data)
            except Exception as e:
                print(f"[avertissement] analyse LLM indisponible ou invalide ({e}), bascule sur l'heuristique locale.")
                data = local_heuristic_analyzer(prompt)
                validate_schema(data)

        # Une fois validate_schema passée sans exception, tous les champs
        # requis existent avec le bon type : accès direct par clé plutôt
        # que .get() avec défaut, pour ne pas masquer une future régression
        # du schéma de validation lui-même.
        return DecisionContext(
            speech_act=data["speech_act"],
            goal=data["goal"],
            domain=data["domain"],
            truth_apt=data["truth_apt"],
            verification=data["verification"],
            external_sources=data["external_sources"],
            sensitivity=data["sensitivity"],
            stakes_level=data["stakes_level"],
            stakes_reason=data["stakes_reason"],
            contains_hypothesis=data["contains_hypothesis"],
            contains_causal_claim=data["contains_causal_claim"],
            contains_quantitative_claim=data["contains_quantitative_claim"],
            analysis_confidence=data["analysis_confidence"],
            intent_tags=data["intent_tags"],
            uncertainty_level=data["uncertainty_level"],
            reasoning_depth=data["reasoning_depth"],
            is_controversial=data["is_controversial"],
            explicit_depth_request=data["explicit_depth_request"],
            is_sensitive_risk=data["is_sensitive_risk"],
        )


def run(prompt: str, offline: bool = False) -> dict:
    ctx = PromptAnalyzerLLM(offline=offline).analyze(prompt)
    constraints = resolve_conflicts(kernel_decide(ctx))
    return build_pipeline(ctx, constraints)


